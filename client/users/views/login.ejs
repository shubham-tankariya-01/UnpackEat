<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Fooder</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; display: flex; align-items: center; justify-content: center; height: 100vh; }
        .card { width: 100%; max-width: 400px; border: none; border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        .btn-primary { border-radius: 10px; padding: 10px; }
    </style>
</head>
<body>
    <div class="card p-4">
        <h2 class="text-center mb-4">Login</h2>
        
        <% if(error && error.length > 0) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>
        <% if(success && success.length > 0) { %>
            <div class="alert alert-success"><%= success %></div>
        <% } %>

        <form action="/login" method="POST">
            <div class="mb-3">
                <label for="mobileNo" class="form-label">Mobile Number</label>
                <input type="text" name="mobileNo" id="mobileNo" class="form-control" placeholder="1234567890" required pattern="[0-9]{10}">
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input type="password" name="password" id="password" class="form-control" placeholder="********" required>
            </div>
            <button type="submit" class="btn btn-primary w-100 mb-3">Login</button>
            <p class="text-center">Don't have an account? <a href="/signup">Sign up</a></p>
        </form>
    </div>
</body>
</html>